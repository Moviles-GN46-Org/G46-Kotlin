<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="94dp"
    android:layout_height="41dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_marker_bubble"
        android:contentDescription="@null" />

    <!-- Zona de texto dentro de la parte superior de la burbuja (32dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvMarkerPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/instrument_sans_bold"
            android:textColor="#3C2E26"
            android:textSize="16sp"
            android:gravity="center"
            android:textAlignment="center"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="$120" />

        <TextView
            android:id="@+id/tvMarkerSuffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="@font/instrument_sans_regular"
            android:text="/mo"
            android:textColor="#8B7364"
            android:textSize="12sp"
            android:maxLines="1" />

    </LinearLayout>
</FrameLayout>
